# Copy to .env for local development. Never commit real credentials.

# --- Server (Firebase Admin SDK) ---
FIREBASE_PROJECT_ID=bssytem-27ee8
# Service-account JSON on one line. Omit to use Application Default Credentials
# (`gcloud auth application-default login`, or the Cloud Run service identity).
FIREBASE_SERVICE_ACCOUNT=
# Comma-separated emails promoted to global admin after verifying their email.
ADMIN_EMAILS=you@example.com
# Website origins allowed to call the API cross-origin (defaults to the Firebase Hosting domains).
# ALLOWED_ORIGINS=https://bssytem-27ee8.web.app,https://bssytem-27ee8.firebaseapp.com
# File storage (unchanged by the Firebase migration).
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# --- Browser (Firebase console > Project settings > Your apps > Web app) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=bssytem-27ee8.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=bssytem-27ee8
VITE_FIREBASE_APP_ID=
# API server URL when it is not on the same origin as the website (leave empty locally).
VITE_API_URL=

# --- Local emulators (optional; `npx firebase-tools emulators:start --only auth,firestore`) ---
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# VITE_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099

# --- One-time migration only (`pnpm migrate:firestore`) ---
# LEGACY_DATABASE_URL=mysql://user:password@host:3306/database
