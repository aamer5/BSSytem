rules_version = '2';

// All reads and writes go through the Express/tRPC backend, which uses the
// Firebase Admin SDK (Admin SDK access bypasses these rules). Browsers never
// talk to Firestore directly, so deny every client request.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
